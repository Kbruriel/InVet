# Configuración de la aplicación
PROJECT_NAME=InVet
API_V1_STR=/api/v1

# Configuración de base de datos
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invet
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invet

# Configuración de seguridad
# SECRET_KEY is required in production. Do NOT commit a production secret here.
# Set a strong secret in your environment or in a secure secrets manager.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Nivel de logging
LOG_LEVEL=INFO